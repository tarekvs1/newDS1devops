
pipeline {
    agent any

    environment {
        PATH = "C:\\Users\\ademk\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
    }

    stages {

        // 1. Checkout
        stage("Checkout") {
            steps {
                echo "Source code checked out from GitHub"
                echo "Full Build Pipeline for dev branch"
            }
        }

        // 2. Setup
        stage("Setup") {
            steps {
                bat 'if not exist artifacts mkdir artifacts'
                bat 'node --version'
                bat 'docker --version'

                echo "Environment ready"
            }
        }

        // 3. Build
        stage("Build") {
            steps {
                script {

                    if (!fileExists("index.html")) {
                        error "index.html does not exist"
                    }

                    if (!fileExists("style.css")) {
                        error "style.css does not exist"
                    }

                    if (!fileExists("script.js")) {
                        error "script.js does not exist"
                    }

                    if (!fileExists("Dockerfile")) {
                        error "Dockerfile does not exist"
                    }

                    echo "All application files are available"

                    // Parallel Node.js checks
                    def checks = [:]

                    ["22", "24"].each { version ->
                        checks["Node.js ${version}"] = {
                            bat """
                                docker run --rm ^
                                -v "%WORKSPACE%:/app" ^
                                -w /app ^
                                node:${version}-alpine ^
                                node --check script.js
                            """
                        }
                    }

                    parallel checks

                    echo "Parallel checks passed"

                    // Docker image build
                    bat 'docker build -t taskflow-push:%BUILD_NUMBER% . > artifacts\\build.log 2>&1'

                    echo "Docker image built successfully"
                }
            }
        }

        // 4. Run (Docker)
        stage("Run (Docker)") {
            steps {
                bat 'docker run -d --name taskflow-push-%BUILD_NUMBER% -p 8082:80 taskflow-push:%BUILD_NUMBER%'

                echo "Docker container started"
            }
        }

        // 5. Smoke Test
        stage("Smoke Test") {
            steps {
                script {
                    def result = powershell(
                        returnStatus: true,
                        script: '''
                            $success = $false

                            for ($i = 0; $i -lt 10 -and !$success; $i++) {
                                try {
                                    $response = Invoke-WebRequest "http://localhost:8082" -UseBasicParsing -TimeoutSec 3
                                    $success = ($response.StatusCode -eq 200)
                                }
                                catch {
                                    Start-Sleep -Seconds 2
                                }
                            }

                            if ($success) {
                                "PASSED - TaskFlow is responding correctly" |
                                    Out-File artifacts/smoke-test.txt -Encoding utf8
                                exit 0
                            }

                            "FAILED - TaskFlow is not responding" |
                                Out-File artifacts/smoke-test.txt -Encoding utf8
                            exit 1
                        '''
                    )

                    if (result != 0) {
                        error "Smoke Test Failed"
                    }

                    echo "Smoke Test Passed"
                }
            }
        }

        // 6. Archive Artifacts
        stage("Archive Artifacts") {
            steps {
                script {
                    def report = """
TASKFLOW PIPELINE REPORT
========================

Job Name: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Branch: dev
Build Result: ${currentBuild.currentResult}

Artifacts:
- build.log
- smoke-test.txt
- pipeline-report.txt
"""

                    writeFile(
                        file: 'artifacts/pipeline-report.txt',
                        text: report
                    )
                }

                archiveArtifacts(
                    artifacts: 'artifacts/build.log, artifacts/smoke-test.txt, artifacts/pipeline-report.txt',
                    fingerprint: true
                )

                echo "Required artifacts archived successfully"
            }
        }
    }

    post {
        always {
            script {
                // Create missing artifact files if a stage failed
                bat '''
                    if not exist artifacts mkdir artifacts
                    if not exist artifacts\\build.log echo Build log unavailable > artifacts\\build.log
                    if not exist artifacts\\smoke-test.txt echo Smoke Test not executed > artifacts\\smoke-test.txt
                '''

                // Generate pipeline report
                writeFile(
                    file: 'artifacts/pipeline-report.txt',
                    text: """TASKFLOW PIPELINE REPORT

Job Name: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Branch: dev
Build Result: ${currentBuild.currentResult}

Artifacts:
- build.log
- smoke-test.txt
- pipeline-report.txt
"""
                )

                // Archive artifacts after a failure too
                if (currentBuild.currentResult != 'SUCCESS') {
                    archiveArtifacts(
                        artifacts: 'artifacts/build.log, artifacts/smoke-test.txt, artifacts/pipeline-report.txt',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }

            // Docker cleanup
            bat 'docker rm -f taskflow-push-%BUILD_NUMBER% 2>nul || exit /b 0'

            echo "Docker cleanup completed"
        }

        success {
            echo "FULL BUILD PIPELINE PASSED"
        }

        failure {
            echo "FULL BUILD PIPELINE FAILED"
        }
    }
}
