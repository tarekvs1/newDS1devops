
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }


    stages {

        // 1. Checkout
        stage("Checkout") {
            steps {
                echo "Source code checked out from Git"
                bat 'git fetch --tags'
            }
        }

        // 2. Setup
        stage("Setup") {
            steps {
                bat 'node --version'
                bat 'docker --version'
                bat 'if not exist artifacts mkdir artifacts'
                bat 'git tag'

                script {
    def version = bat(
        script: '@git describe --tags --exact-match HEAD',
        returnStdout: true
    ).trim()

    echo "Detected version: [${version}]"

    if (!(version ==~ /v[0-9]+[.][0-9]+[.][0-9]+/)) {
        error "Invalid version tag: ${version}. Expected vX.Y.Z"
    }

    env.TAG_NAME = version

    echo "Version detected: ${env.TAG_NAME}"
}
            }
        }

        // 3. Build
        stage("Build") {
            steps {
                script {

                    if (!fileExists("index.html")) {
                        error "index.html does not exist"
                    }

                    if (!fileExists("style.css")) {
                        error "style.css does not exist"
                    }

                    if (!fileExists("script.js")) {
                        error "script.js does not exist"
                    }

                    if (!fileExists("Dockerfile")) {
                        error "Dockerfile does not exist"
                    }

                    echo "All application files are available"

                    // Parallel Node.js checks
                    def checks = [:]

                    ["22", "24"].each { version ->
                        checks["Node.js ${version}"] = {
                            bat """
                                docker run --rm ^
                                -v "%WORKSPACE%:/app" ^
                                -w /app ^
                                node:${version}-alpine ^
                                node --check script.js
                            """
                        }
                    }

                    parallel checks

                    echo "Parallel checks passed"

                    // Build versioned Docker image
                    bat "docker build -t taskflow:${env.TAG_NAME} . > artifacts\\build.log 2>&1"

                    echo "Versioned Docker image built successfully"
                }
            }
        }

        // 4. Run (Docker)
        stage("Run (Docker)") {
            steps {
                bat "docker run -d --name taskflow-%BUILD_NUMBER% -p 8082:80 taskflow:${env.TAG_NAME}"

                echo "Versioned Docker container started"
            }
        }

        // 5. Smoke Test
        stage("Smoke Test") {
            steps {
                script {
                    def result = powershell(
                        returnStatus: true,
                        script: '''
                            $success = $false

                            for ($i = 0; $i -lt 10 -and !$success; $i++) {
                                try {
                                    $response = Invoke-WebRequest "http://localhost:8082" -UseBasicParsing -TimeoutSec 3
                                    $success = ($response.StatusCode -eq 200)
                                }
                                catch {
                                    Start-Sleep -Seconds 2
                                }
                            }

                            if ($success) {
                                "PASSED - Versioned TaskFlow is responding correctly" |
                                    Out-File artifacts/smoke-test.txt -Encoding utf8
                                exit 0
                            }

                            "FAILED - Versioned TaskFlow is not responding" |
                                Out-File artifacts/smoke-test.txt -Encoding utf8
                            exit 1
                        '''
                    )

                    if (result != 0) {
                        error "Smoke Test Failed"
                    }

                    echo "Smoke Test Passed"
                }
            }
        }

        // 6. Archive Artifacts
        stage("Archive Artifacts") {
            steps {
                script {
                    writeFile(
                        file: 'artifacts/pipeline-report.txt',
                        text: """TASKFLOW VERSIONED BUILD REPORT

Job Name: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Version Tag: ${env.TAG_NAME}
Build Result: ${currentBuild.currentResult}

Artifacts:
- build.log
- smoke-test.txt
- pipeline-report.txt
"""
                    )
                }

                archiveArtifacts(
                    artifacts: 'artifacts/build.log, artifacts/smoke-test.txt, artifacts/pipeline-report.txt',
                    fingerprint: true
                )

                echo "Versioned artifacts archived successfully"
            }
        }
    }

    post {
        always {
            script {
                // Create missing files if a stage failed
                bat '''
                    if not exist artifacts mkdir artifacts
                    if not exist artifacts\\build.log echo Build log unavailable > artifacts\\build.log
                    if not exist artifacts\\smoke-test.txt echo Smoke Test not executed > artifacts\\smoke-test.txt
                '''

                // Generate pipeline report
                writeFile(
                    file: 'artifacts/pipeline-report.txt',
                    text: """TASKFLOW VERSIONED BUILD REPORT

Job Name: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
Version Tag: ${env.TAG_NAME ?: 'Not detected'}
Build Result: ${currentBuild.currentResult}

Artifacts:
- build.log
- smoke-test.txt
- pipeline-report.txt
"""
                )

                // Archive artifacts after failure
                if (currentBuild.currentResult != 'SUCCESS') {
                    archiveArtifacts(
                        artifacts: 'artifacts/build.log, artifacts/smoke-test.txt, artifacts/pipeline-report.txt',
                        fingerprint: true
                    )
                }
            }

            // Docker cleanup
            bat 'docker rm -f taskflow-%BUILD_NUMBER% 2>nul || exit /b 0'

            echo "Docker cleanup completed"
        }

        success {
            echo "VERSIONED BUILD PIPELINE PASSED"
        }

        failure {
            echo "VERSIONED BUILD PIPELINE FAILED"
        }
    }
}
