
pipeline {
    agent any



    stages {

        // 1. Checkout
        stage("Checkout") {
            steps {
                echo "Source code checked out from Git"
            }
        }

        // 2. Setup
        stage("Setup") {
            steps {
                bat 'node --version'
                bat 'docker --version'
                echo "Environment ready"
            }
        }

        // 3. Build
        stage("Build") {
            steps {
                script {
                    if (!fileExists("index.html")) {
                        error "index.html does not exist"
                    }

                    if (!fileExists("style.css")) {
                        error "style.css does not exist"
                    }

                    if (!fileExists("script.js")) {
                        error "script.js does not exist"
                    }

                    if (!fileExists("Dockerfile")) {
                        error "Dockerfile does not exist"
                    }

                    echo "All application files are available"
                }
            }
        }

        // 4. Run (Docker)
        stage("Run (Docker)") {
            steps {
                bat 'docker build -t taskflow:%BUILD_NUMBER% .'
                bat 'docker run -d --name taskflow-%BUILD_NUMBER% -p 8082:80 taskflow:%BUILD_NUMBER%'
                echo "Docker container started"
            }
        }

        // 5. Smoke Test
        stage("Smoke Test") {
            steps {
                script {
                    bat 'if not exist artifacts mkdir artifacts'

                    def result = powershell(
                        returnStatus: true,
                        script: '''
                            $success = $false

                            for ($i = 0; $i -lt 10 -and !$success; $i++) {
                                try {
                                    $response = Invoke-WebRequest "http://localhost:8082" -UseBasicParsing -TimeoutSec 3
                                    $success = ($response.StatusCode -eq 200)
                                }
                                catch {
                                    Start-Sleep -Seconds 2
                                }
                            }

                            if ($success) {
                                "PASSED - Application is responding" | Out-File artifacts/smoke-test.txt
                                exit 0
                            }

                            "FAILED - Application is not responding" | Out-File artifacts/smoke-test.txt
                            exit 1
                        '''
                    )

                    if (result != 0) {
                        error "Smoke Test Failed"
                    }

                    echo "Smoke Test Passed"
                }
            }
        }

        // 6. Archive Artifacts
        
stage("Archive Artifacts") {
    steps {
        archiveArtifacts(
            artifacts: 'artifacts/build.log, artifacts/smoke-test.txt, artifacts/pipeline-report.txt',
            fingerprint: true
        )

        echo "Required artifacts archived successfully"
    }
}

    }

    post {
        always {
            bat 'docker rm -f taskflow-%BUILD_NUMBER% 2>nul || exit /b 0'
            echo "Docker cleanup completed"
        }

        success {
            echo "BUILD AND SMOKE PIPELINE PASSED"
        }

        failure {
            echo "BUILD AND SMOKE PIPELINE FAILED"
        }
    }
}
